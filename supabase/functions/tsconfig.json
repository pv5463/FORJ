{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ESNext", "DOM"],
    "strict": false,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "https://*": ["./deno.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.d.ts"]
}
